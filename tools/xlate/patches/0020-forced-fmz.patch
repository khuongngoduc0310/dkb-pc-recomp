+        // The host asks for Maxwell's FMZ rule (0 x anything = 0, infinities and NaN included) on every FP32
+        // multiply of this shader. Only shaders the runtime names get it (DKB_FMZ_STAGES), so the cost stays with them.
+        private static bool ForceFmz(EmitterContext context, Instruction fpType)
+        {
+            return fpType == Instruction.FP32 && context.TranslatorContext != null && context.TranslatorContext.GpuAccessor.QueryForceFmz();
+        }
+
+        private static Operand FmzSelect(EmitterContext context, Operand a, Operand b, Operand zeroResult, Operand result)
+        {
+            Operand zero = ConstF(0f);
+            Operand r = context.ConditionalSelect(context.FPCompareEqual(b, zero), zeroResult, result);
+            return context.ConditionalSelect(context.FPCompareEqual(a, zero), zeroResult, r);
+        }
